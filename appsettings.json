{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DuplicatePhotoDetect": {
    // The DINOv2 model (model_fp16.onnx). Leave empty to look for Downloads\DinoV2\model_fp16.onnx in this folder and its parents
    "ModelPath": "",
    // Run the model on the GPU with DirectML (falls back to the CPU if the GPU can't be used)
    "UseGpu": true,
    // The DirectML GPU adapter: 0 is usually the integrated GPU, 1 the dedicated one
    "GpuDeviceId": 0,
    // The folder the scan box starts with. Leave empty to use "Sample Images\Listing" if it can be found
    "DefaultFolder": ""
  }
}
